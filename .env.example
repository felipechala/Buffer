# Copy to .env and fill in. NEVER commit real keys. .env is gitignored.

# Capital One Nessie sandbox (stands in for the company's bank API)
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_API_KEY=
NESSIE_CUSTOMER_ID=            # the single Nessie customer that represents the company

# CashGuard public API demo tenant token (Authorization: Bearer ...)
CASHGUARD_API_KEY=cg_test_demo_key

# Execution gateway: false = simulated execution only; true = also write to the Nessie sandbox
SANDBOX_WRITES_ENABLED=false

# App
DATABASE_PATH=./treasurytwin.db
SIMULATION_DEFAULT_SEED=42
CASHGUARD_DEMO=1               # boot with fixtures/cashguard_demo.json (Acme Co) instead of Northstar

# Optional LLM layer (explainer + deepagents orchestrator). Everything works without these.
ANTHROPIC_API_KEY=
CASHGUARD_EXPLAIN_MODEL=claude-haiku-5-5
CASHGUARD_AGENT_MODEL=claude-sonnet-5-5
CASHGUARD_EXPLAIN=1            # 0 = template explanations only (no LLM call)
